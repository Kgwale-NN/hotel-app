# Local PostgreSQL settings. For hosting, set DATABASE_URL instead.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_haven
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use the TLS options in the hosted provider's connection URL.

SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NODE_ENV=development
PORT=3000
# Set to the hosting proxy hop count in production (Render: 1).
TRUST_PROXY_HOPS=0

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

PAYSTACK_SECRET_KEY=replace-with-paystack-test-secret-key
PAYSTACK_CALLBACK_URL=http://localhost:5173/payments/return

# In production, point this to a persistent mounted directory.
# ROOM_PHOTO_DIRECTORY=/var/data/room-photos
